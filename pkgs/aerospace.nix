{ lib
, stdenv
, bash
, cacert
, coreutils
, git
, gnused
, version
, src
}:

stdenv.mkDerivation {
  pname = "aerospace";
  inherit version src;

  # Xcode is supplied by Apple rather than Nix. Its SDK and toolchain must be
  # reachable while building this macOS application.
  __noChroot = true;

  nativeBuildInputs = [
    bash
    cacert
    coreutils
    git
    gnused
  ];

  buildPhase = ''
    runHook preBuild

    export HOME="$TMPDIR/home"
    mkdir -p "$HOME"
    export CFFIXED_USER_HOME="$HOME"
    export GIT_SSL_CAINFO="${cacert}/etc/ssl/certs/ca-bundle.crt"
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0=http.version
    export GIT_CONFIG_VALUE_0=HTTP/1.1
    export GIT_TERMINAL_PROMPT=0
    export SSL_CERT_FILE="$GIT_SSL_CAINFO"
    export SWIFTPM_DISABLE_SANDBOX=1
    export SWIFT_BUILD_USE_SANDBOX=0
    export DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
    export SDKROOT="$(/usr/bin/xcrun --sdk macosx --show-sdk-path)"
    unset NIX_CFLAGS_COMPILE NIX_CFLAGS_LINK NIX_LDFLAGS

    cat > Sources/Common/versionGenerated.swift <<'EOF'
    // FILE IS GENERATED BY Nix
    public let aeroSpaceAppVersion = "${version}"
    EOF
    cat > Sources/Common/gitHashGenerated.swift <<'EOF'
    // FILE IS GENERATED BY Nix
    public let gitHash = "${version}"
    public let gitShortHash = "${version}"
    EOF

    /usr/bin/swift build --disable-sandbox -c release --product aerospace
    /usr/bin/xcodebuild \
      -project xcode/AeroSpace.xcodeproj \
      -scheme AeroSpace \
      -configuration Release \
      -disableAutomaticPackageResolution \
      -IDEPackageSupportDisableManifestSandbox=1 \
      -IDEPackageSupportDisablePackageSandbox=1 \
      -IDEPackageSupportDisablePluginExecutionSandbox=1 \
      -derivedDataPath xcode/.xcode-build \
      CODE_SIGNING_ALLOWED=NO \
      'OTHER_SWIFT_FLAGS=$(inherited) -disable-sandbox' \
      build

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p "$out/Applications" "$out/bin"
    cp -R xcode/.xcode-build/Build/Products/Release/AeroSpace.app "$out/Applications/"
    cp .build/release/aerospace "$out/bin/aerospace"

    runHook postInstall
  '';

  meta = {
    description = "i3-like tiling window manager for macOS, built from source";
    homepage = "https://github.com/nikitabobko/AeroSpace";
    license = lib.licenses.mit;
    platforms = lib.platforms.darwin;
    mainProgram = "aerospace";
  };
}
